{
  "name": "ai-presentation-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "start:fixture": "node src/server.mjs --fixture",
    "test:browser": "node tests/browser/foundation.mjs && node tests/browser/grove-css-fidelity.mjs && node tests/browser/multipage-edit-preview.mjs && node tests/browser/recovery.mjs && node tests/browser/export.mjs",
    "test:browser:foundation": "node tests/browser/foundation.mjs",
    "test:browser:recovery": "node tests/browser/recovery.mjs",
    "test:browser:export": "node tests/browser/export.mjs",
    "test:browser:headed": "node tests/browser/foundation.mjs --headed",
    "test:browser:real": "node tests/browser/real-grove.mjs",
    "test:browser:real:cancel": "node tests/browser/real-cancel.mjs",
    "test:browser:real:replay": "node tests/browser/real-grove.mjs --reuse-latest",
    "test:browser:grove-css": "node tests/browser/grove-css-fidelity.mjs",
    "test:browser:multipage": "node tests/browser/multipage-edit-preview.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "grapesjs": "0.23.2",
    "playwright-core": "1.61.1"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "pdfjs-dist": "^6.1.200"
  }
}
